[Unit]
Description=cws: multi-session WebSocket bridge (Node.js, claude/codex)
After=network.target

[Service]
Type=simple
WorkingDirectory=/my/run/cws
ExecStart=/usr/bin/node /my/run/cws/src/server.js
Restart=always
RestartSec=3
Environment=PATH=/www/server/nodejs/v24.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
